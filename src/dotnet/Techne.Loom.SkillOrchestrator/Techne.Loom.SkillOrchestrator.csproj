<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Techne.Loom.Abstractions\Techne.Loom.Abstractions.csproj" />
    <ProjectReference Include="..\Techne.Loom.Common\Techne.Loom.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\..\docs\en\reference\products\so-guide.md">
      <Link>guide-assets\en\so-guide.md</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Pack>true</Pack>
      <PackagePath>lib\$(TargetFramework)\guide-assets\en\</PackagePath>
    </None>
    <None Include="..\..\..\docs\zh-cn\reference\products\so-guide.md">
      <Link>guide-assets\zh-cn\so-guide.md</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Pack>true</Pack>
      <PackagePath>lib\$(TargetFramework)\guide-assets\zh-cn\</PackagePath>
    </None>
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>true</IsPackable>
    <AssemblyName>so</AssemblyName>
    <UseAppHost>false</UseAppHost>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Techne.Loom.SkillOrchestrator</PackageId>
    <RootNamespace>Techne.Loom.SkillOrchestrator</RootNamespace>
    <Description>Deterministic workflow execution and tracking for Techne Loom skills.</Description>
    <PackageTags>$(TechneLoomBasePackageTags);skill-orchestrator;deterministic;workflow;so</PackageTags>
    <PackageReleaseNotes>Initial 0.1.0 preview release of deterministic skill workflow tracker and CLI.</PackageReleaseNotes>
  </PropertyGroup>

</Project>
