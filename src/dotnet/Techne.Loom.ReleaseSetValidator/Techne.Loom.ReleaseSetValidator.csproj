<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Techne.Loom.Common\Techne.Loom.Common.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Techne.Loom.ReleaseSetValidator</PackageId>
    <RootNamespace>Techne.Loom.ReleaseSetValidator</RootNamespace>
    <Description>CI validator for the Techne Loom release package set.</Description>
    <PackageTags>$(TechneLoomBasePackageTags);release;validation</PackageTags>
  </PropertyGroup>

</Project>
