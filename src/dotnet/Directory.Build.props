<Project>
  <PropertyGroup Condition="'$(IsPackable)' != 'false'">
    <VersionPrefix>0.1.0</VersionPrefix>
    <Authors>Wayne Wang 韦恩卑鄙</Authors>
    <Company>Wayne Wang 韦恩卑鄙</Company>
    <Copyright>Copyright (c) 2026 Techne Loom Contributors</Copyright>
    <PackageProjectUrl>https://github.com/waynebaby/Techne-Loom</PackageProjectUrl>
    <RepositoryUrl>https://github.com/waynebaby/Techne-Loom.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <TechneLoomBasePackageTags>techne-loom;orchestration;workflow;agent;mcp;dotnet</TechneLoomBasePackageTags>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildProjectDirectory)\README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)..\..\icon.png" Pack="true" PackagePath="\" Visible="false">
      <Link>icon.png</Link>
    </None>
  </ItemGroup>
</Project>
