<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Techne.Loom.Abstractions\Techne.Loom.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Techne.Loom.Common</PackageId>
    <RootNamespace>Techne.Loom.Common</RootNamespace>
    <Description>Host-agnostic runtime helpers for Techne Loom.</Description>
    <PackageTags>$(TechneLoomBasePackageTags);common;runtime;utilities</PackageTags>
    <PackageReleaseNotes>Initial 0.1.0 release of shared runtime helpers.</PackageReleaseNotes>
  </PropertyGroup>

</Project>
