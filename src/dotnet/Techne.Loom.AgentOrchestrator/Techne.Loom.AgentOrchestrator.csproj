<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Techne.Loom.Abstractions\Techne.Loom.Abstractions.csproj" />
    <ProjectReference Include="..\Techne.Loom.Common\Techne.Loom.Common.csproj" />
  </ItemGroup>


  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Techne.Loom.AgentOrchestrator.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>true</IsPackable>
    <AssemblyName>ao</AssemblyName>
    <UseAppHost>false</UseAppHost>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Techne.Loom.AgentOrchestrator</PackageId>
    <RootNamespace>Techne.Loom.AgentOrchestrator</RootNamespace>
    <Description>Exploratory orchestration CLI for Loom Agent Execution Orchestrator.</Description>
    <PackageTags>$(TechneLoomBasePackageTags);agent-orchestrator;exploratory;orchestration;ao</PackageTags>
    <PackageReleaseNotes>Initial 0.1.0 preview release of exploratory orchestration CLI.</PackageReleaseNotes>
  </PropertyGroup>
  <PropertyGroup>
    <TechneLoomDirectDocsForBuild>true</TechneLoomDirectDocsForBuild>
    <TechneLoomDirectDocsForPackage>true</TechneLoomDirectDocsForPackage>
  </PropertyGroup>
  <Import Project="..\Techne.Loom.DirectDocs.targets" />

</Project>
