{
  "instanceId": "loom-enhanced-research-so-governed",
  "templateKind": "so-governed-target-skill",
  "taskType": "skill_enhancement",
  "workflowKind": "target_skill_enhancement",
  "caseId": "loom-enhanced-research",
  "runId": "template:loom-enhanced-research-2-1",
  "validation": {
    "gates": {
      "gate.runtime_bundle_ready": {
        "description": "Hard gate proving the bound SO runtime path has been attempted and preflight evidence exists before any downstream skill work.",
        "passExpression": "gate_outputs_present == true",
        "requiredOutputFamilies": [
          "published_package_workflow_evidence",
          "runtime_preflight_result",
          "resolved_runtime_version_ref",
          "runtime_bundle_packages_ref"
        ],
        "requiredMachineReadableOutputFamilies": [
          "published_package_workflow_evidence",
          "runtime_preflight_result",
          "resolved_runtime_version_ref",
          "runtime_bundle_packages_ref"
        ],
        "requiredHumanReviewableOutputFamilies": []
      },
      "gate.runtime_guide_ready": {
        "description": "Hard gate proving a fresh guide surface exists before intake, research, drafting, or review work begins.",
        "passExpression": "gate_outputs_present == true",
        "requiredOutputFamilies": [
          "resolved_guide_surface_ref"
        ],
        "requiredMachineReadableOutputFamilies": [
          "resolved_guide_surface_ref"
        ],
        "requiredHumanReviewableOutputFamilies": []
      },
      "gate.runtime_exception_recorded": {
        "description": "Blocked strongest-earned gate for the published-package preflight failure and the explicitly approved repo-src workaround used in this enhancement pass.",
        "passExpression": "gate_outputs_present == true",
        "requiredOutputFamilies": [
          "published_runtime_preflight_failure",
          "workaround_approval_ref",
          "workaround_runtime_ref",
          "workaround_runtime_guide_ref"
        ],
        "requiredMachineReadableOutputFamilies": [
          "published_runtime_preflight_failure",
          "workaround_approval_ref",
          "workaround_runtime_ref",
          "workaround_runtime_guide_ref"
        ],
        "requiredHumanReviewableOutputFamilies": [
          "published_runtime_preflight_failure"
        ]
      },
      "gate.final_report_done": {
        "description": "Terminal business-output gate for a governed research run.",
        "passExpression": "gate_outputs_present == true",
        "requiredOutputFamilies": [
          "final_report",
          "round_ledger",
          "completion_manifest_reference",
          "completion_manifest_md"
        ],
        "requiredMachineReadableOutputFamilies": [
          "final_report",
          "round_ledger",
          "completion_manifest_reference",
          "completion_manifest_md"
        ],
        "requiredHumanReviewableOutputFamilies": [
          "final_report",
          "completion_manifest_md"
        ]
      }
    },
    "routes": {
      "route.first_governed_happy_path": {
        "description": "Normal governed route using the published SO runtime path.",
        "requiredTerminalGateIds": [
          "gate.final_report_done"
        ],
        "requiredBlockedGateIds": []
      },
      "route.first_governed_exception_path": {
        "description": "Exception-aware governed route for this enhancement pass when published-package startup preflight fails because so.deps.json is missing.",
        "requiredTerminalGateIds": [
          "gate.final_report_done"
        ],
        "requiredBlockedGateIds": [
          "gate.runtime_exception_recorded"
        ]
      }
    },
    "declaredUserOwnedFields": [
      "research_goal",
      "seed_query",
      "seed_urls",
      "max_depth",
      "max_rounds",
      "output_root",
      "evidence_policy",
      "demo_mode",
      "user_language",
      "intake_comments",
      "material_review_decision",
      "material_review_comments",
      "material_review_payload",
      "draft_review_decision",
      "draft_review_comments",
      "draft_review_payload"
    ],
    "reservedRuntimeOwnedFields": [
      "workflow_file",
      "event_log_file",
      "workflow_instance_file",
      "analysis_file",
      "mermaid_file",
      "html_file",
      "audit_artifacts",
      "runtime_preflight_result",
      "resolved_so_runtime",
      "resolved_guide_surface",
      "published_runtime_preflight_failure",
      "workaround_runtime",
      "workaround_runtime_guide",
      "completion_manifest_reference",
      "completion_manifest_md"
    ]
  },
  "startNodeId": "state.start",
  "currentNodeId": "state.start",
  "endNodeId": "state.done",
  "status": "readyToStart",
  "context": {},
  "nodes": {
    "state.start": {
      "$kind": "state",
      "id": "state.start",
      "name": "Start",
      "description": "Start the first Loom-governanced loom-enhanced-research run.",
      "workflowPhase": "01 Runtime Proof",
      "groups": [
        {
          "id": "group.start",
          "transitionIds": [
            "transition.capture_runtime_preflight"
          ]
        }
      ],
      "waitBehavior": "blockUntilComplete"
    },
    "state.runtime_path_decision": {
      "$kind": "state",
      "id": "state.runtime_path_decision",
      "name": "Runtime Path Decision",
      "description": "Choose the published-runtime path or the blocked exception path based on preflight evidence.",
      "workflowPhase": "01 Runtime Proof",
      "groups": [
        {
          "id": "group.runtime_path_decision",
          "transitionIds": [
            "transition.use_published_runtime_path",
            "transition.use_blocked_exception_path"
          ]
        }
      ],
      "waitBehavior": "blockUntilComplete"
    },
    "state.runtime_guide": {
      "$kind": "state",
      "id": "state.runtime_guide",
      "name": "Capture Published Runtime Guide",
      "description": "Capture a fresh guide from the published SO runtime before any skill-specific work.",
      "workflowPhase": "01 Runtime Proof",
      "groups": [
        {
          "id": "group.runtime_guide",
          "transitionIds": [
            "transition.capture_published_runtime_guide"
          ]
        }
      ],
      "waitBehavior": "blockUntilComplete"
    },
    "state.runtime_exception": {
      "$kind": "state",
      "id": "state.runtime_exception",
      "name": "Record Runtime Exception",
      "description": "Record the published-package preflight failure and the explicitly approved repo-src workaround for this enhancement pass.",
      "workflowPhase": "01 Runtime Proof",
      "groups": [
        {
          "id": "group.runtime_exception",
          "transitionIds": [
            "transition.capture_runtime_exception_workaround"
          ]
        }
      ],
      "waitBehavior": "blockUntilComplete"
    },
    "state.intake": {
      "$kind": "state",
      "id": "state.intake",
      "name": "Intake",
      "description": "Collect or confirm the research contract, including first-class intake comments.",
      "workflowPhase": "02 Intake",
      "groups": [
        {
          "id": "group.intake",
          "transitionIds": [
            "transition.collect_intake_contract"
          ]
        }
      ],
      "waitBehavior": "blockUntilComplete"
    },
    "state.setup": {
      "$kind": "state",
      "id": "state.setup",
      "name": "Initialize Run Artifacts",
      "description": "Prepare the run root, ledgers, material inventory structure, and report output targets.",
      "workflowPhase": "03 Setup",
      "groups": [
        {
          "id": "group.setup",
          "transitionIds": [
            "transition.initialize_run_artifacts"
          ]
        }
      ],
      "waitBehavior": "blockUntilComplete"
    },
    "state.research_round": {
      "$kind": "state",
      "id": "state.research_round",
      "name": "Research Round",
      "description": "Execute one bounded research round. This is the only state that may publish net-new evidence.",
      "workflowPhase": "04 Research Loop",
      "groups": [
        {
          "id": "group.research_round",
          "transitionIds": [
            "transition.execute_research_round"
          ]
        }
      ],
      "waitBehavior": "blockUntilComplete"
    },
    "state.research_continue_decision": {
      "$kind": "state",
      "id": "state.research_continue_decision",
      "name": "Research Continue Decision",
      "description": "Choose whether another evidence-creating round is needed or whether to stop and review materials.",
      "workflowPhase": "04 Research Loop",
      "groups": [
        {
          "id": "group.research_continue_decision",
          "transitionIds": [
            "transition.continue_research",
            "transition.stop_research"
          ]
        }
      ],
      "waitBehavior": "blockUntilComplete"
    },
    "state.material_inventory": {
      "$kind": "state",
      "id": "state.material_inventory",
      "name": "Build Material Inventory",
      "description": "Assemble the full reviewable inventory of gathered materials without creating new evidence.",
      "workflowPhase": "05 Material Review",
      "groups": [
        {
          "id": "group.material_inventory",
          "transitionIds": [
            "transition.build_material_inventory"
          ]
        }
      ],
      "waitBehavior": "blockUntilComplete"
    },
    "state.material_review": {
      "$kind": "state",
      "id": "state.material_review",
      "name": "Material Review",
      "description": "Collect structured selection and freeform comments about gathered materials.",
      "workflowPhase": "05 Material Review",
      "groups": [
        {
          "id": "group.material_review",
          "transitionIds": [
            "transition.collect_material_review"
          ]
        }
      ],
      "waitBehavior": "blockUntilComplete"
    },
    "state.material_review_decision": {
      "$kind": "state",
      "id": "state.material_review_decision",
      "name": "Material Review Decision",
      "description": "Branch to more research or draft generation using existing materials plus user comments.",
      "workflowPhase": "05 Material Review",
      "groups": [
        {
          "id": "group.material_review_decision",
          "transitionIds": [
            "transition.material_review_more_research",
            "transition.material_review_start_draft"
          ]
        }
      ],
      "waitBehavior": "blockUntilComplete"
    },
    "state.research_seed_update": {
      "$kind": "state",
      "id": "state.research_seed_update",
      "name": "Update Research Seed",
      "description": "Merge material-review or draft-review feedback into the next bounded research seed without claiming new evidence.",
      "workflowPhase": "06 Continuation",
      "groups": [
        {
          "id": "group.research_seed_update",
          "transitionIds": [
            "transition.update_research_seed"
          ]
        }
      ],
      "waitBehavior": "blockUntilComplete"
    },
    "state.draft": {
      "$kind": "state",
      "id": "state.draft",
      "name": "Generate Report Draft",
      "description": "Generate the report draft from the existing evidence chain and review comments.",
      "workflowPhase": "07 Drafting",
      "groups": [
        {
          "id": "group.draft",
          "transitionIds": [
            "transition.generate_report_draft"
          ]
        }
      ],
      "waitBehavior": "blockUntilComplete"
    },
    "state.draft_review": {
      "$kind": "state",
      "id": "state.draft_review",
      "name": "Draft Review",
      "description": "Collect structured decision and freeform comments about the written draft.",
      "workflowPhase": "08 Draft Review",
      "groups": [
        {
          "id": "group.draft_review",
          "transitionIds": [
            "transition.collect_draft_review"
          ]
        }
      ],
      "waitBehavior": "blockUntilComplete"
    },
    "state.draft_review_decision": {
      "$kind": "state",
      "id": "state.draft_review_decision",
      "name": "Draft Review Decision",
      "description": "Branch to finalize, more research, or material reselection.",
      "workflowPhase": "08 Draft Review",
      "groups": [
        {
          "id": "group.draft_review_decision",
          "transitionIds": [
            "transition.draft_review_finalize",
            "transition.draft_review_more_research",
            "transition.draft_review_reselect_materials"
          ]
        }
      ],
      "waitBehavior": "blockUntilComplete"
    },
    "state.publish_final": {
      "$kind": "state",
      "id": "state.publish_final",
      "name": "Publish Final Report",
      "description": "Publish the final report and emit the runtime-owned completion manifest.",
      "workflowPhase": "09 Finalization",
      "groups": [
        {
          "id": "group.publish_final",
          "transitionIds": [
            "transition.publish_final_report"
          ]
        }
      ],
      "waitBehavior": "blockUntilComplete"
    },
    "state.done": {
      "$kind": "state",
      "id": "state.done",
      "name": "Done",
      "description": "Governed research run completed with final business outputs.",
      "workflowPhase": "09 Finalization",
      "groups": [],
      "waitBehavior": "blockUntilComplete"
    },
    "transition.capture_runtime_preflight": {
      "$kind": "command",
      "id": "transition.capture_runtime_preflight",
      "name": "Capture runtime preflight",
      "description": "Pause for published-package runtime preflight and weave back startup-contract evidence before any downstream work.",
      "targetNodeId": "state.runtime_path_decision",
      "outputPath": "resolved_so_runtime",
      "stepKind": "waitResume",
      "guardExpression": "true",
      "succeedExpression": "true",
      "satisfiesGateIds": [
        "gate.runtime_bundle_ready"
      ],
      "publishesOutputFamilies": [
        "published_package_workflow_evidence",
        "runtime_preflight_result",
        "resolved_runtime_version_ref",
        "runtime_bundle_packages_ref"
      ],
      "command": {
        "kind": "tool",
        "name": "workflow.captureRuntimePreflight",
        "environmentKey": "",
        "parameters": {
          "resumeOutputKey": "resolved_so_runtime",
          "lockFilePath": "assets/so-workflow/so-package-lock.json",
          "requiredInputs": [
            "published_package_workflow_evidence",
            "runtime_preflight_result",
            "resolved_runtime_version_ref",
            "runtime_bundle_packages_ref",
            "resolved_so_runtime"
          ],
          "outputBindings": {
            "published_package_workflow_evidence": "$context:published_package_workflow_evidence",
            "runtime_preflight_result": "$context:runtime_preflight_result",
            "resolved_runtime_version_ref": "$context:resolved_runtime_version_ref",
            "runtime_bundle_packages_ref": "$context:runtime_bundle_packages_ref"
          }
        }
      }
    },
    "transition.use_published_runtime_path": {
      "$kind": "expr",
      "id": "transition.use_published_runtime_path",
      "name": "Use published runtime path",
      "description": "Continue on the ordinary governed runtime path when package preflight passed.",
      "targetNodeId": "state.runtime_guide",
      "stepKind": "conditionBranch",
      "guardExpression": "runtime_preflight_result == \u0027passed\u0027",
      "succeedExpression": "runtime_preflight_result == \u0027passed\u0027"
    },
    "transition.use_blocked_exception_path": {
      "$kind": "expr",
      "id": "transition.use_blocked_exception_path",
      "name": "Use blocked exception path",
      "description": "Enter the exception route when the published package preflight did not pass and explicit blocked-state workaround evidence will be recorded.",
      "targetNodeId": "state.runtime_exception",
      "stepKind": "conditionBranch",
      "guardExpression": "runtime_preflight_result != \u0027passed\u0027",
      "succeedExpression": "runtime_preflight_result != \u0027passed\u0027"
    },
    "transition.capture_published_runtime_guide": {
      "$kind": "command",
      "id": "transition.capture_published_runtime_guide",
      "name": "Capture published runtime guide",
      "description": "Pause for a fresh guide export from the published SO runtime before intake or research work.",
      "targetNodeId": "state.intake",
      "outputPath": "resolved_guide_surface",
      "stepKind": "waitResume",
      "guardExpression": "true",
      "succeedExpression": "true",
      "satisfiesGateIds": [
        "gate.runtime_guide_ready"
      ],
      "publishesOutputFamilies": [
        "resolved_guide_surface_ref"
      ],
      "command": {
        "kind": "tool",
        "name": "workflow.captureGuideSurface",
        "environmentKey": "",
        "parameters": {
          "resumeOutputKey": "resolved_guide_surface",
          "command": "dotnet so.dll --guide",
          "languageInput": "user_language",
          "requiredInputs": [
            "resolved_guide_surface_ref",
            "resolved_guide_surface"
          ],
          "outputBindings": {
            "resolved_guide_surface_ref": "$context:resolved_guide_surface_ref"
          }
        }
      }
    },
    "transition.capture_runtime_exception_workaround": {
      "$kind": "command",
      "id": "transition.capture_runtime_exception_workaround",
      "name": "Capture runtime exception workaround",
      "description": "Pause for explicit recording of the failed package preflight plus the approved repo-src debug workaround and its fresh guide output, then weave back into the governed route.",
      "targetNodeId": "state.intake",
      "outputPath": "workaround_runtime_guide",
      "stepKind": "waitResume",
      "guardExpression": "true",
      "succeedExpression": "true",
      "blockedRoutes": [
        "route.first_governed_exception_path"
      ],
      "satisfiesGateIds": [
        "gate.runtime_exception_recorded",
        "gate.runtime_guide_ready"
      ],
      "publishesBlockedOutputFamilies": [
        "published_runtime_preflight_failure",
        "workaround_approval_ref",
        "workaround_runtime_ref",
        "workaround_runtime_guide_ref",
        "resolved_guide_surface_ref"
      ],
      "command": {
        "kind": "tool",
        "name": "workflow.captureRuntimeExceptionWorkaround",
        "environmentKey": "",
        "parameters": {
          "resumeOutputKey": "workaround_runtime_guide",
          "requiredInputs": [
            "published_runtime_preflight_failure",
            "workaround_approval_ref",
            "workaround_runtime_ref",
            "workaround_runtime_guide_ref",
            "resolved_guide_surface_ref",
            "workaround_runtime_guide"
          ],
          "skillHint": "Record the failed package preflight evidence, the explicit user approval for the repo-src debug workaround, the local runtime directory, and the fresh guide path captured from that workaround runtime. This is blocked-state evidence only and must not normalize repo-src as the ordinary path.",
          "outputBindings": {
            "published_runtime_preflight_failure": "$context:published_runtime_preflight_failure",
            "workaround_approval_ref": "$context:workaround_approval_ref",
            "workaround_runtime_ref": "$context:workaround_runtime_ref",
            "workaround_runtime_guide_ref": "$context:workaround_runtime_guide_ref",
            "resolved_guide_surface_ref": "$context:resolved_guide_surface_ref"
          }
        }
      }
    },
    "transition.collect_intake_contract": {
      "$kind": "command",
      "id": "transition.collect_intake_contract",
      "name": "Collect intake contract",
      "description": "Ask for structured intake inputs and preserve freeform intake comments as first-class workflow input.",
      "targetNodeId": "state.setup",
      "stepKind": "askUser",
      "guardExpression": "true",
      "succeedExpression": "true",
      "ownedInputMode": "user",
      "command": {
        "kind": "tool",
        "name": "workflow.collectResearchIntake",
        "environmentKey": "",
        "parameters": {
          "requiredInputs": [
            "research_goal",
            "seed_query",
            "seed_urls",
            "max_depth",
            "max_rounds",
            "output_root",
            "evidence_policy",
            "demo_mode",
            "user_language",
            "intake_comments"
          ]
        }
      }
    },
    "transition.initialize_run_artifacts": {
      "$kind": "command",
      "id": "transition.initialize_run_artifacts",
      "name": "Initialize run artifacts",
      "description": "Create ledgers, materials, notes, UI, and report output structures before the first evidence-creating round.",
      "targetNodeId": "state.research_round",
      "outputPath": "run_artifact_root",
      "stepKind": "toolCall",
      "guardExpression": "true",
      "succeedExpression": "true",
      "command": {
        "kind": "tool",
        "name": "workflow.initializeResearchArtifacts",
        "environmentKey": "",
        "parameters": {
          "outputRootInput": "output_root"
        }
      }
    },
    "transition.execute_research_round": {
      "$kind": "command",
      "id": "transition.execute_research_round",
      "name": "Execute research round",
      "description": "Run one bounded research round and publish the only allowed net-new evidence delta in the workflow.",
      "targetNodeId": "state.research_continue_decision",
      "outputPath": "round_ledger",
      "stepKind": "subagentCall",
      "guardExpression": "true",
      "succeedExpression": "round_ledger != null && evidence_delta != null && material_candidates != null",
      "publishesOutputFamilies": [
        "round_ledger",
        "evidence_delta",
        "material_candidates"
      ],
      "command": {
        "kind": "tool",
        "name": "workflow.executeResearchRound",
        "environmentKey": "",
        "parameters": {
          "skillHint": "Execute exactly one bounded research round. Publish trigger, working hypothesis, chosen action, evidence captured, round summary, and continue/stop rationale. Only this node may publish new evidence.",
          "requiredInputs": [
            "research_goal",
            "seed_query",
            "seed_urls",
            "max_depth",
            "max_rounds",
            "intake_comments",
            "round_ledger"
          ]
        }
      }
    },
    "transition.continue_research": {
      "$kind": "expr",
      "id": "transition.continue_research",
      "name": "Continue research",
      "description": "Loop for another evidence-creating round only when budget and evidence state justify it.",
      "targetNodeId": "state.research_round",
      "stepKind": "conditionBranch",
      "guardExpression": "round_ledger.continue_research == true",
      "succeedExpression": "round_ledger.continue_research == true"
    },
    "transition.stop_research": {
      "$kind": "expr",
      "id": "transition.stop_research",
      "name": "Stop research",
      "description": "Leave the evidence-creation loop and build the full material inventory.",
      "targetNodeId": "state.material_inventory",
      "stepKind": "conditionBranch",
      "guardExpression": "round_ledger.continue_research != true",
      "succeedExpression": "round_ledger.continue_research != true"
    },
    "transition.build_material_inventory": {
      "$kind": "command",
      "id": "transition.build_material_inventory",
      "name": "Build material inventory",
      "description": "Assemble a reviewable inventory of sources, findings, excerpts, screenshots, and provenance without creating new evidence.",
      "targetNodeId": "state.material_review",
      "outputPath": "material_inventory",
      "stepKind": "toolCall",
      "guardExpression": "true",
      "succeedExpression": "material_inventory != null",
      "publishesOutputFamilies": [
        "material_inventory"
      ],
      "command": {
        "kind": "tool",
        "name": "workflow.buildMaterialInventory",
        "environmentKey": "",
        "parameters": {
          "requiredInputs": [
            "round_ledger",
            "material_candidates"
          ]
        }
      }
    },
    "transition.collect_material_review": {
      "$kind": "command",
      "id": "transition.collect_material_review",
      "name": "Collect material review",
      "description": "Collect structured selections and freeform comments about the gathered materials.",
      "targetNodeId": "state.material_review_decision",
      "outputPath": "material_review_payload",
      "stepKind": "askUser",
      "guardExpression": "true",
      "succeedExpression": "material_review_payload != null",
      "ownedInputMode": "user",
      "publishesOutputFamilies": [
        "material_review_payload"
      ],
      "command": {
        "kind": "tool",
        "name": "workflow.collectMaterialReview",
        "environmentKey": "",
        "parameters": {
          "requiredInputs": [
            "material_review_decision",
            "material_review_comments",
            "material_review_payload"
          ]
        }
      }
    },
    "transition.material_review_more_research": {
      "$kind": "expr",
      "id": "transition.material_review_more_research",
      "name": "Material review requests more research",
      "description": "Return to the bounded research loop with explicit continuation context.",
      "targetNodeId": "state.research_seed_update",
      "stepKind": "conditionBranch",
      "guardExpression": "material_review_decision == \u0027more_research\u0027",
      "succeedExpression": "material_review_decision == \u0027more_research\u0027"
    },
    "transition.material_review_start_draft": {
      "$kind": "expr",
      "id": "transition.material_review_start_draft",
      "name": "Material review starts draft",
      "description": "Proceed to draft generation using the existing evidence set.",
      "targetNodeId": "state.draft",
      "stepKind": "conditionBranch",
      "guardExpression": "material_review_decision == \u0027draft\u0027",
      "succeedExpression": "material_review_decision == \u0027draft\u0027"
    },
    "transition.update_research_seed": {
      "$kind": "command",
      "id": "transition.update_research_seed",
      "name": "Update research seed",
      "description": "Carry forward user review comments and selected context into the next research pass without claiming new evidence.",
      "targetNodeId": "state.research_round",
      "outputPath": "continuation_payload",
      "stepKind": "toolCall",
      "guardExpression": "true",
      "succeedExpression": "true",
      "command": {
        "kind": "tool",
        "name": "workflow.updateResearchSeed",
        "environmentKey": "",
        "parameters": {
          "requiredInputs": [
            "material_review_payload",
            "draft_review_payload"
          ]
        }
      }
    },
    "transition.generate_report_draft": {
      "$kind": "command",
      "id": "transition.generate_report_draft",
      "name": "Generate report draft",
      "description": "Generate a report draft from existing evidence, round history, material review, and unresolved questions.",
      "targetNodeId": "state.draft_review",
      "outputPath": "report_draft",
      "stepKind": "subagentCall",
      "guardExpression": "true",
      "succeedExpression": "report_draft != null",
      "publishesOutputFamilies": [
        "report_draft"
      ],
      "command": {
        "kind": "tool",
        "name": "workflow.generateReportDraft",
        "environmentKey": "",
        "parameters": {
          "skillHint": "Generate the draft from existing evidence only. Include conclusion, scope, round history, evidence chain, cited sources, unresolved questions, and material-review summary. Do not claim net-new evidence creation.",
          "requiredInputs": [
            "material_inventory",
            "material_review_payload",
            "round_ledger"
          ]
        }
      }
    },
    "transition.collect_draft_review": {
      "$kind": "command",
      "id": "transition.collect_draft_review",
      "name": "Collect draft review",
      "description": "Collect structured decision and freeform comments on the written draft.",
      "targetNodeId": "state.draft_review_decision",
      "outputPath": "draft_review_payload",
      "stepKind": "askUser",
      "guardExpression": "true",
      "succeedExpression": "draft_review_payload != null",
      "ownedInputMode": "user",
      "publishesOutputFamilies": [
        "draft_review_payload"
      ],
      "command": {
        "kind": "tool",
        "name": "workflow.collectDraftReview",
        "environmentKey": "",
        "parameters": {
          "requiredInputs": [
            "draft_review_decision",
            "draft_review_comments",
            "draft_review_payload"
          ]
        }
      }
    },
    "transition.draft_review_finalize": {
      "$kind": "expr",
      "id": "transition.draft_review_finalize",
      "name": "Finalize report",
      "description": "Publish the final report when the user approves the draft.",
      "targetNodeId": "state.publish_final",
      "stepKind": "conditionBranch",
      "guardExpression": "draft_review_decision == \u0027finalize\u0027",
      "succeedExpression": "draft_review_decision == \u0027finalize\u0027"
    },
    "transition.draft_review_more_research": {
      "$kind": "expr",
      "id": "transition.draft_review_more_research",
      "name": "Draft review requests more research",
      "description": "Return to the evidence-creating research loop with explicit rationale from draft review.",
      "targetNodeId": "state.research_seed_update",
      "stepKind": "conditionBranch",
      "guardExpression": "draft_review_decision == \u0027more_research\u0027",
      "succeedExpression": "draft_review_decision == \u0027more_research\u0027"
    },
    "transition.draft_review_reselect_materials": {
      "$kind": "expr",
      "id": "transition.draft_review_reselect_materials",
      "name": "Draft review requests material reselection",
      "description": "Return to material review without claiming a new evidence delta.",
      "targetNodeId": "state.material_review",
      "stepKind": "conditionBranch",
      "guardExpression": "draft_review_decision == \u0027reselect_materials\u0027",
      "succeedExpression": "draft_review_decision == \u0027reselect_materials\u0027"
    },
    "transition.publish_final_report": {
      "$kind": "command",
      "id": "transition.publish_final_report",
      "name": "Publish final report",
      "description": "Publish the final Markdown report and emit a runtime-owned completion manifest that references the governed source assets and produced outputs.",
      "targetNodeId": "state.done",
      "outputPath": "final_report",
      "stepKind": "toolCall",
      "guardExpression": "true",
      "succeedExpression": "true",
      "terminalRoutes": [
        "route.first_governed_happy_path",
        "route.first_governed_exception_path"
      ],
      "satisfiesGateIds": [
        "gate.final_report_done"
      ],
      "publishesOutputFamilies": [
        "final_report",
        "round_ledger",
        "completion_manifest_reference",
        "completion_manifest_md"
      ],
      "command": {
        "kind": "tool",
        "name": "workflow.publishFinalReport",
        "environmentKey": "",
        "parameters": {
          "requiredInputs": [
            "report_draft",
            "draft_review_payload",
            "round_ledger"
          ],
          "outputBindings": {
            "final_report": "$context:final_report",
            "round_ledger": "$context:round_ledger",
            "completion_manifest_reference": "$context:completion_manifest_reference",
            "completion_manifest_md": "$result"
          }
        }
      }
    }
  }
}
