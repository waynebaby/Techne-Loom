          "mcpPreflightExempt": true,
          "runtimePreflight": true,
          "requiredInputs": [
            "published_package_workflow_evidence",
            "runtime_preflight_result",
            "resolved_runtime_version_ref",
            "runtime_bundle_packages_ref",
            "unified_runtime_directory_ref",
            "governance_entry_transport",
            "mcp_registration_attempt_evidence",
            "runtime_launch_descriptor_ref",
