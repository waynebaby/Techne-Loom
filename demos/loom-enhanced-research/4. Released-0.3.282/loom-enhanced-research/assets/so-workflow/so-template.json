            "runtime_preflight_result": "$context:runtime_preflight_result",
            "resolved_runtime_version_ref": "$context:resolved_runtime_version_ref",
            "runtime_bundle_packages_ref": "$context:runtime_bundle_packages_ref",
            "unified_runtime_directory_ref": "$context:unified_runtime_directory_ref",
            "governance_entry_transport": "$context:governance_entry_transport",
            "mcp_registration_attempt_evidence": "$context:mcp_registration_attempt_evidence",
