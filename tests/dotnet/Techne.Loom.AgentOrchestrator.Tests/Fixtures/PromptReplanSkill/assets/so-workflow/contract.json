{
  "name": "ao-prompt-replan-test-fixture",
  "inputs": {
    "topic": "Test prompt-replan topic."
  },
  "outputs": {
    "workflow": "Prompt-replan workflow fixture."
  },
  "default_assumptions": {},
  "context_fields": {
    "schemaVersion": "loom.context-fields.v1",
    "fields": [
      {
        "path": "topic",
        "type": "string",
        "nullable": false,
        "owner": "caller",
        "description": "Prompt-replan topic supplied by the test caller.",
        "suggested_values": [],
        "suggestion_reason": "The test input supplies the topic."
      },
      {
        "path": "answers.displayName",
        "type": "string",
        "nullable": true,
        "owner": "user",
        "description": "Display name collected by the AO AskUser test workflow."
      },
      {
        "path": "objective",
        "type": "string",
        "nullable": true,
        "owner": "caller",
        "description": "Plan objective supplied by the AO sessionless test."
      },
      {
        "path": "plan.answer",
        "type": "string",
        "nullable": true,
        "owner": "agent",
        "description": "Answer returned by the sessionless plan result."
      },
      {
        "path": "plan.evidence",
        "type": "string",
        "nullable": true,
        "owner": "agent",
        "description": "Evidence returned by the sessionless plan result."
      },
      {
        "path": "plan.consumed_result_ids",
        "type": "array",
        "itemType": "string",
        "nullable": false,
        "owner": "runtime",
        "description": "Plan result identifiers already consumed by the runtime."
      },
      {
        "path": "result.message",
        "type": "string",
        "nullable": true,
        "owner": "runtime",
        "description": "Message emitted by the sessionless echo transition."
      },
      {
        "path": "first_output",
        "type": "string",
        "nullable": false,
        "owner": "agent",
        "description": "First fanout branch output used by tests."
      },
      {
        "path": "second_output",
        "type": "string",
        "nullable": false,
        "owner": "agent",
        "description": "Second fanout branch output used by tests."
      },
      {
        "path": "loop_output",
        "type": "string",
        "nullable": false,
        "owner": "agent",
        "description": "Loop branch output used by tests."
      },
      {
        "path": "candidate.first",
        "type": "string",
        "nullable": false,
        "owner": "agent",
        "description": "First candidate output used by tests."
      },
      {
        "path": "candidate.second",
        "type": "string",
        "nullable": false,
        "owner": "agent",
        "description": "Second candidate output used by tests."
      },
      {
        "path": "result.answer",
        "type": "string",
        "nullable": false,
        "owner": "agent",
        "description": "Fanout answer used by tests."
      },
      {
        "path": "shared.result",
        "type": "object",
        "nullable": false,
        "owner": "agent",
        "description": "Shared output object used by tests."
      },
      {
        "path": "shared.result.child",
        "type": "string",
        "nullable": false,
        "owner": "agent",
        "description": "Nested shared output used by tests."
      },
      {
        "path": "route_output",
        "type": "string",
        "nullable": false,
        "owner": "agent",
        "description": "Route output used by tests."
      },
      {
        "path": "sync_output",
        "type": "string",
        "nullable": false,
        "owner": "agent",
        "description": "Synchronous output used by tests."
      },
      {
        "path": "timeout_output",
        "type": "string",
        "nullable": false,
        "owner": "agent",
        "description": "Timeout output used by tests."
      },
      {
        "path": "contract_output",
        "type": "string",
        "nullable": false,
        "owner": "agent",
        "description": "Contract reference output used by tests."
      },
      {
        "path": "zero",
        "type": "integer",
        "nullable": false,
        "owner": "caller",
        "description": "Zero used to trigger an expression error in tests."
      }
    ]
  }
}
