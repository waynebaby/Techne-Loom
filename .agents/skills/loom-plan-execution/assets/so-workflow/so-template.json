      ],
      "waitBehavior": "blockUntilComplete"
    },
    "state.review": {
      "$kind": "state",
      "id": "state.review",
      "name": "Review Governance Surfaces",
      "description": "Review AO skill and workflow-designer governance surfaces.",
      "workflowPhase": "02 Compile Review",
      "groups": [
        {
          "id": "group.review",
          "transitionIds": [
            "transition.review_ao_skill_wording",
            "transition.review_ao_workflow_designer"
          ]
        }
      ],
      "waitBehavior": "blockUntilComplete"
    },
    "state.template": {
