      "workflowPhase": "03 Official Runnable",
      "groups": [
        {
          "id": "group.replan_full",
          "transitionIds": [
            "transition.design_full"
          ]
        }
      ],
      "waitBehavior": "blockUntilComplete"
    },
    "state.replan_workaround": {
      "$kind": "state",
      "id": "state.replan_workaround",
