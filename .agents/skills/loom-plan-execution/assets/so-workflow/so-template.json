          "gate.official_done"
        ],
        "requiredBlockedGateIds": [
          "gate.official_blocked"
        ]
      }
    },
    "declaredUserOwnedFields": [
      "approval_decision",
      "feedback_notes",
      "guide_language"
    ],
    "reservedRuntimeOwnedFields": [
      "workflow_file",
      "event_log_file",
      "workflow_instance_file",
      "analysis_file",
      "mermaid_file",
      "html_file",
      "audit_artifacts",
      "resolved_so_runtime",
      "resolved_guide_surface"
    ]
  },
