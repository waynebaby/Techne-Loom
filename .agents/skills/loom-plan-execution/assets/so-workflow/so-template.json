          "workflow_mermaid_md",
          "workflow_html",
          "workflow_analysis_json"
        ],
        "requiredMachineReadableOutputFamilies": [
          "workflow_mermaid_md",
          "workflow_html",
          "workflow_analysis_json"
        ],
        "requiredHumanReviewableOutputFamilies": [
          "workflow_analysis_json"
        ]
      },
      "gate.official_blocked": {
        "description": "Blocked strongest-earned gate for official runnable route.",
        "requiredOutputFamilies": [
          "workflow_runtime_copy_json",
          "event_log_file"
        ],
        "requiredMachineReadableOutputFamilies": [
          "workflow_runtime_copy_json",
          "event_log_file"
        ],
        "requiredHumanReviewableOutputFamilies": []
      },
      "gate.official_done": {
        "description": "Terminal gate for official runnable route to final Done.",
