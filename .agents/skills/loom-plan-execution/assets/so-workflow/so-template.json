      "workflowPhase": "03 Official Runnable",
      "groups": [
        {
          "id": "group.blocker_history",
          "transitionIds": [
            "transition.capture_blocker_history"
          ]
        }
      ],
      "waitBehavior": "blockUntilComplete"
    },
    "state.replan_strategy": {
      "$kind": "state",
      "id": "state.replan_strategy",
      "name": "Select Replan Strategy",
      "description": "Give AO planner the retained blocker history and require one explicit recovery strategy.",
      "workflowPhase": "03 Official Runnable",
      "groups": [
        {
          "id": "group.replan_strategy",
          "transitionIds": [
            "transition.plan_recovery_strategy"
          ]
