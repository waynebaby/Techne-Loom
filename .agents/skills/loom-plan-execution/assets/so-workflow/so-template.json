    "transition.collect_governance_scope": {
      "$kind": "command",
      "id": "transition.collect_governance_scope",
      "name": "Collect governance scope",
      "description": "Collect and persist AO enhancement scope before review.",
      "targetNodeId": "state.review",
      "outputPath": "governanceScope",
      "stepKind": "askUser",
      "guardExpression": "true",
      "succeedExpression": "true",
      "command": {
        "kind": "tool",
        "name": "collect-governance-scope",
        "parameters": {}
      },
      "currentRetryCount": 0,
      "maxRetry": 3
    },
    "transition.review_ao_skill_wording": {
      "$kind": "command",
      "id": "transition.review_ao_skill_wording",
      "name": "Review AO skill wording",
      "description": "Review AO SKILL governance wording against deterministic contract rules.",
      "targetNodeId": "state.review_workflow_designer",
      "outputPath": "skillReview",
      "stepKind": "modelThink",
      "guardExpression": "true",
      "succeedExpression": "true",
      "command": {
        "kind": "tool",
        "name": "review-skill-wording",
        "parameters": {}
      },
      "currentRetryCount": 0,
      "maxRetry": 3
    },
    "transition.review_ao_workflow_designer": {
      "$kind": "command",
      "id": "transition.review_ao_workflow_designer",
      "name": "Review AO workflow designer",
      "description": "Review AO workflow-designer transition/gate contract quality.",
      "targetNodeId": "state.template",
      "outputPath": "designerReview",
      "stepKind": "subagentCall",
      "guardExpression": "true",
      "succeedExpression": "true",
      "command": {
        "kind": "tool",
        "name": "review-workflow-designer",
        "parameters": {}
      },
      "currentRetryCount": 0,
      "maxRetry": 3
    },
    "transition.refresh_governed_template": {
      "$kind": "command",
      "id": "transition.refresh_governed_template",
      "name": "Refresh governed template",
      "description": "Refresh governed template with latest review findings.",
      "targetNodeId": "state.compile_review",
      "outputPath": "templateRefresh",
      "stepKind": "modelThink",
      "guardExpression": "true",
      "succeedExpression": "true",
      "command": {
        "kind": "tool",
        "name": "refresh-template",
        "parameters": {}
      },
      "currentRetryCount": 0,
      "maxRetry": 3
    },
    "transition.compile_template": {
      "$kind": "command",
      "id": "transition.compile_template",
      "name": "Compile template",
      "description": "Compile template and collect analysis artifacts.",
      "targetNodeId": "state.runtime",
      "outputPath": "compileAudit",
      "stepKind": "waitResume",
      "guardExpression": "true",
      "succeedExpression": "true",
      "command": {
        "kind": "tool",
        "name": "compile-template",
        "parameters": {
          "resumeOutputKey": "compileAudit",
          "requiredInputs": [
            "compileAudit",
            "workflow_mermaid_md",
            "workflow_html",
            "workflow_analysis_json"
          ],
          "satisfiesGateIds": [
            "gate.compile_review_ready"
          ],
          "publishesOutputFamilies": [
            "workflow_mermaid_md",
            "workflow_html",
            "workflow_analysis_json"
          ]
        }
      },
      "currentRetryCount": 0,
      "maxRetry": 3
    },
    "transition.run_official_route": {
      "$kind": "command",
      "id": "transition.run_official_route",
      "name": "Run official route",
      "description": "Execute public run route on runtime workflow copy.",
      "targetNodeId": "state.runtime_result",
      "outputPath": "runResult",
      "stepKind": "waitResume",
      "guardExpression": "true",
      "succeedExpression": "true",
      "command": {
        "kind": "tool",
        "name": "run-official-route",
        "parameters": {
          "gateFailureTargetStateId": "state.runtime_result",
          "resumeOutputKey": "run_result",
          "requiredInputs": [
            "run_result"
          ],
          "blockedRoutes": [
            "official_runnable_route"
          ],
          "satisfiesGateIds": [
            "gate.official_blocked"
          ],
          "publishesBlockedOutputFamilies": [
            "workflow_runtime_copy_json",
            "event_log_file",
            "blocker_report"
          ],
          "outputBindings": {
            "blocker_report": "$context:runResult.blocker_report",
            "attempt_history": "$context:runResult.attempt_history",
            "event_log_file": "$context:runResult.event_log_file",
            "audit_artifacts": "$context:runResult.audit_artifacts",
            "workflow_runtime_copy_json": "$context:runResult.workflow_runtime_copy_json",
            "terminal_evidence": "$context:runResult.terminal_evidence",
            "checked_in_skill_markdown_asset": "$context:runResult.checked_in_skill_markdown_asset",
            "checked_in_workflow_designer_asset": "$context:runResult.checked_in_workflow_designer_asset",
            "completion_manifest_reference": "$context:runResult.completion_manifest_reference"
          }
        }
      },
      "currentRetryCount": 0,
      "maxRetry": 3
    },
    "transition.route_run_blocked": {
      "$kind": "expr",
      "id": "transition.route_run_blocked",
      "name": "Route blocked result",
      "description": "Send a blocked official-run result into durable blocker-history capture.",
      "targetNodeId": "state.blocker_history",
      "stepKind": "conditionBranch",
      "guardExpression": "runResult.status == \u0027blocked\u0027",
      "succeedExpression": "runResult.blocker_report != null",
      "priority": 0
    },
    "transition.route_run_terminal": {
      "$kind": "command",
      "id": "transition.route_run_terminal",
      "name": "Complete terminal run result",
      "description": "Commit a terminal official-run result to the governed Done state after terminal evidence is supplied.",
      "targetNodeId": "state.done",
      "stepKind": "toolCall",
      "guardExpression": "runResult.status == \u0027completed\u0027 \u0026\u0026 runResult.terminal_evidence",
      "succeedExpression": "runResult.status == \u0027completed\u0027 \u0026\u0026 runResult.terminal_evidence",
      "terminalRoutes": [
        "official_runnable_route"
      ],
      "satisfiesGateIds": [
        "gate.official_done"
      ],
      "publishesOutputFamilies": [
        "checked_in_skill_markdown_asset",
        "checked_in_workflow_designer_asset",
        "workflow_runtime_copy_json",
        "event_log_file",
        "completion_manifest_reference"
      ],
      "command": {
        "kind": "tool",
        "name": "noop",
        "parameters": {
          "outputBindings": {
            "checked_in_skill_markdown_asset": "$context:runResult.checked_in_skill_markdown_asset",
            "checked_in_workflow_designer_asset": "$context:runResult.checked_in_workflow_designer_asset",
            "completion_manifest_reference": "$context:runResult.completion_manifest_reference",
            "workflow_runtime_copy_json": "$context:workflow_runtime_copy_json",
            "event_log_file": "$context:event_log_file"
          },
          "message": "terminal evidence checkpoint",
          "resumeOutputKey": "run_result"
        }
      },
      "currentRetryCount": 0,
      "maxRetry": 3,
      "outputPath": "terminal_marker"
    },
    "transition.capture_blocker_history": {
      "$kind": "command",
      "id": "transition.capture_blocker_history",
      "name": "Capture blocker history",
      "description": "Persist current workflow state, blocker, attempted remedies, outcomes, event/audit references, and evidence before planner re-entry.",
      "targetNodeId": "state.replan_strategy",
      "outputPath": "replan_history",
      "stepKind": "waitResume",
      "guardExpression": "blocker_report != null \u0026\u0026 event_log_file != null",
      "succeedExpression": "replan_history != null \u0026\u0026 attempt_history != null \u0026\u0026 audit_artifacts != null",
      "command": {
        "kind": "tool",
        "name": "capture-blocker-history",
        "parameters": {
          "resumeOutputKey": "replan_history",
          "requiredInputs": [
            "workflow_file",
            "workflow_instance_file",
            "current_node_id",
            "last_transition_id",
            "blocker_report",
            "attempt_history",
            "event_log_file",
            "audit_artifacts",
            "evidence_references"
          ],
          "satisfiesGateIds": [
            "gate.replan_history_ready"
          ],
          "publishesOutputFamilies": [
            "replan_history",
            "blocker_report",
            "attempt_history",
            "event_log_file",
            "audit_artifacts"
          ]
        }
      },
      "currentRetryCount": 0,
      "maxRetry": 3
    },
    "transition.plan_recovery_strategy": {
      "$kind": "command",
      "id": "transition.plan_recovery_strategy",
      "name": "Plan recovery strategy",
      "description": "Give the AO planner retained blocker history and require one explicit strategy plus a viable terminal path.",
      "targetNodeId": "state.replan_route",
      "outputPath": "replan_strategy",
      "stepKind": "subagentCall",
      "guardExpression": "replan_history != null",
      "succeedExpression": "replan_strategy != null \u0026\u0026 replan_anchor != null",
      "command": {
        "kind": "tool",
        "name": "workflow.invokeRecoveryPlanner",
        "parameters": {
          "resumeOutputKey": "replan_strategy",
          "requiredInputs": [
            "replan_history",
            "terminal_business_objective",
            "replan_strategy",
            "replan_anchor",
            "candidate_terminal_path"
          ],
          "allowedStrategies": [
            "continue_from_current",
            "rollback_to_unconfirmed",
            "redesign_from_current",
            "full_redesign",
            "reversible_workaround"
          ],
          "requiredOutputs": [
            "replan_strategy",
            "replan_anchor",
            "candidate_terminal_path"
          ]
        }
      },
      "currentRetryCount": 0,
      "maxRetry": 3
    },
    "transition.continue_from_current": {
      "$kind": "expr",
      "id": "transition.continue_from_current",
      "name": "Continue from current",
      "description": "Route to current-state bridge design.",
      "targetNodeId": "state.replan_current",
      "stepKind": "conditionBranch",
      "guardExpression": "replan_strategy == \u0027continue_from_current\u0027 \u0026\u0026 replan_anchor != null",
      "succeedExpression": "replan_anchor != null"
    },
    "transition.rollback_to_unconfirmed": {
      "$kind": "expr",
      "id": "transition.rollback_to_unconfirmed",
      "name": "Rollback to unconfirmed",
      "description": "Route to the latest unconfirmed node design.",
      "targetNodeId": "state.replan_unconfirmed",
      "stepKind": "conditionBranch",
      "guardExpression": "replan_strategy == \u0027rollback_to_unconfirmed\u0027 \u0026\u0026 replan_anchor != null",
      "succeedExpression": "replan_anchor != null"
    },
    "transition.redesign_from_current": {
      "$kind": "expr",
      "id": "transition.redesign_from_current",
      "name": "Redesign from current",
      "description": "Route to failing-continuation redesign.",
