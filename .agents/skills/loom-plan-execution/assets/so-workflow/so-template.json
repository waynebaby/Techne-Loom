      "waitBehavior": "blockUntilComplete"
    },
    "state.replan_route": {
      "$kind": "state",
      "id": "state.replan_route",
      "name": "Route Selected Replan Strategy",
      "description": "Select exactly one of the five recovery strategies after the AO planner returns.",
      "workflowPhase": "03 Official Runnable",
      "groups": [
        {
          "id": "group.replan_routes",
          "transitionIds": [
            "transition.continue_from_current",
            "transition.rollback_to_unconfirmed",
            "transition.redesign_from_current",
            "transition.full_redesign",
            "transition.reversible_workaround",
            "transition.replan_contract_invalid"
          ]
        }
      ],
      "waitBehavior": "blockUntilComplete"
    },
    "state.replan_current": {
      "$kind": "state",
      "id": "state.replan_current",
      "name": "Continue From Current",
      "description": "Design a viable bridge from the current blocked state to the terminal business outcome.",
      "workflowPhase": "03 Official Runnable",
      "groups": [
        {
          "id": "group.replan_current",
          "transitionIds": [
            "transition.design_from_current"
          ]
        }
      ],
      "waitBehavior": "blockUntilComplete"
    },
    "state.replan_unconfirmed": {
      "$kind": "state",
      "id": "state.replan_unconfirmed",
      "name": "Rollback To Unconfirmed Node",
      "description": "Select the latest unconfirmed or not-yet-designed node and design forward from that anchor.",
      "workflowPhase": "03 Official Runnable",
      "groups": [
        {
          "id": "group.replan_unconfirmed",
          "transitionIds": [
            "transition.design_from_unconfirmed"
          ]
        }
      ],
      "waitBehavior": "blockUntilComplete"
    },
    "state.replan_redesign": {
      "$kind": "state",
      "id": "state.replan_redesign",
      "name": "Redesign Failing Continuation",
      "description": "Preserve completed history and replace the failing continuation from the current state.",
      "workflowPhase": "03 Official Runnable",
      "groups": [
        {
          "id": "group.replan_redesign",
          "transitionIds": [
            "transition.design_redesign"
          ]
        }
      ],
      "waitBehavior": "blockUntilComplete"
    },
    "state.replan_full": {
      "$kind": "state",
      "id": "state.replan_full",
