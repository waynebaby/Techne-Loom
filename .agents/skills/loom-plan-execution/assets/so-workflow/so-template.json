{
  "instanceId": "loom-plan-execution-governance-upgrade",
  "templateKind": "so-governed-target-skill",
  "validation": {
    "gates": {
      "gate.compile_review_ready": {
        "description": "Compile-review gate for AO governance enhancement template.",
        "requiredOutputFamilies": [
          "workflow_mermaid_md",
          "workflow_html",
          "workflow_analysis_json"
        ],
        "requiredMachineReadableOutputFamilies": [
          "workflow_mermaid_md",
          "workflow_html",
          "workflow_analysis_json"
        ],
        "requiredHumanReviewableOutputFamilies": [
          "workflow_analysis_json"
        ],
        "passExpression": "compileAudit != null"
      },
      "gate.official_blocked": {
        "description": "Blocked strongest-earned gate for official runnable route.",
        "requiredOutputFamilies": [
          "workflow_runtime_copy_json",
          "event_log_file"
        ],
        "requiredMachineReadableOutputFamilies": [
          "workflow_runtime_copy_json",
          "event_log_file"
        ],
        "requiredHumanReviewableOutputFamilies": [],
        "passExpression": "workflow_runtime_copy_json != null \u0026\u0026 event_log_file != null \u0026\u0026 blocker_report != null"
      },
      "gate.official_done": {
        "description": "Terminal gate for official runnable route to final Done.",
        "requiredOutputFamilies": [
          "checked_in_skill_markdown_asset",
          "checked_in_workflow_designer_asset",
          "workflow_runtime_copy_json",
          "event_log_file",
          "completion_manifest_reference"
        ],
        "requiredMachineReadableOutputFamilies": [
          "checked_in_skill_markdown_asset",
          "checked_in_workflow_designer_asset",
          "workflow_runtime_copy_json",
          "event_log_file",
          "completion_manifest_reference"
        ],
        "requiredHumanReviewableOutputFamilies": [
          "completion_manifest_reference"
        ],
        "passExpression": "completion_manifest_reference != null \u0026\u0026 workflow_runtime_copy_json != null \u0026\u0026 event_log_file != null"
      },
      "gate.replan_history_ready": {
        "description": "Blocked-route history gate proving the planner received the current state, blocker, attempts, outcomes, and evidence before redesign.",
        "requiredOutputFamilies": [
          "replan_history",
          "blocker_report",
          "attempt_history",
          "event_log_file",
          "audit_artifacts"
        ],
        "requiredMachineReadableOutputFamilies": [
          "replan_history",
          "blocker_report",
          "attempt_history",
          "event_log_file",
          "audit_artifacts"
        ],
        "requiredHumanReviewableOutputFamilies": [
          "replan_history"
        ],
        "passExpression": "replan_history != null \u0026\u0026 blocker_report != null \u0026\u0026 attempt_history != null"
      },
      "gate.replan_path_ready": {
        "description": "Replan gate proving the selected anchor and strategy produce a viable path to the terminal business outcome.",
        "requiredOutputFamilies": [
          "replan_strategy",
          "replan_anchor",
          "candidate_terminal_path",
          "replan_evidence_references"
        ],
        "requiredMachineReadableOutputFamilies": [
          "replan_strategy",
          "replan_anchor",
          "candidate_terminal_path",
          "replan_evidence_references"
        ],
        "requiredHumanReviewableOutputFamilies": [
          "candidate_terminal_path"
        ],
        "passExpression": "candidate_terminal_path != null \u0026\u0026 replan_evidence_references != null"
      }
    },
    "routes": {
      "official_runnable_route": {
        "description": "Official SO-governed route for AO enhancement.",
        "requiredTerminalGateIds": [
          "gate.official_done"
        ],
        "requiredBlockedGateIds": [
          "gate.official_blocked"
        ]
      },
      "official_replan_route": {
        "description": "Official route resumed after blocker history and replan-path validation.",
        "requiredTerminalGateIds": [
          "gate.official_done",
          "gate.replan_path_ready"
        ],
        "requiredBlockedGateIds": []
      }
    },
    "declaredUserOwnedFields": [
      "approval_decision",
      "feedback_notes",
      "terminal_business_objective"
    ],
    "reservedRuntimeOwnedFields": [
      "workflow_file",
      "event_log_file",
      "workflow_instance_file",
      "analysis_file",
      "mermaid_file",
      "html_file",
      "audit_artifacts",
      "resolved_so_runtime",
      "resolved_guide_surface",
      "replan_history",
      "blocker_report",
      "attempt_history",
      "replan_strategy",
      "replan_anchor",
      "candidate_terminal_path",
      "rollback_plan",
      "replan_evidence_references",
      "evidence_references"
    ]
  },
  "startNodeId": "state.start",
  "currentNodeId": "state.start",
  "endNodeId": "state.done",
  "status": "readyToStart",
  "context": {},
  "nodes": {
    "state.start": {
      "$kind": "state",
      "id": "state.start",
