  "validation": {
    "gates": {
      "gate.compile_review_ready": {
        "description": "Compile-review gate for AO governance enhancement template.",
        "requiredOutputFamilies": [
          "workflow_mermaid_md",
          "workflow_html",
          "workflow_analysis_json"
        ],
        "requiredMachineReadableOutputFamilies": [
          "workflow_mermaid_md",
          "workflow_html",
          "workflow_analysis_json"
        ],
        "requiredHumanReviewableOutputFamilies": [
          "workflow_analysis_json"
        ],
        "passExpression": "context.Get<object?>(\u0022compileAudit\u0022) != null",
        "failureGuidance": {
          "summary": "Compile-review evidence is missing or the generated Mermaid, HTML, and analysis artifacts do not describe the current workflow.",
          "nextAction": "Dispatch the workflow designer, repair the authoritative template, rerun dotnet so.dll compile, and return fresh workflow_mermaid_md, workflow_html, workflow_analysis_json plus the gate self-review.",
          "evidenceReferences": [
            { "path": ".agents/skills/loom-skill-enhancement/assets/agents/loom-skill-enhancement-workflow-designer.agent.md", "startLine": 66, "endLine": 66, "quote": "### Gate Failure Guidance Hard Gate (Required)" },
            { "path": ".agents/skills/loom-skill-enhancement/SKILL.md", "startLine": 112, "endLine": 112, "quote": "Run `dotnet so.dll compile` against that exact external copy" }
          ]
        }
      },
      "gate.official_blocked": {
        "description": "Blocked strongest-earned gate for official runnable route.",
        "requiredOutputFamilies": [
          "workflow_runtime_copy_json",
          "event_log_file"
        ],
        "requiredMachineReadableOutputFamilies": [
          "workflow_runtime_copy_json",
          "event_log_file"
        ],
        "requiredHumanReviewableOutputFamilies": [],
        "passExpression": "context.Get<object?>(\u0022workflow_runtime_copy_json\u0022) != null \u0026\u0026 context.Get<object?>(\u0022event_log_file\u0022) != null \u0026\u0026 context.Get<object?>(\u0022blocker_report\u0022) != null",
        "failureGuidance": {
          "summary": "The blocked route lacks the runtime workflow copy, event log, or blocker evidence needed to resume safely.",
          "nextAction": "Inspect the same external workflow copy, restore workflow_runtime_copy_json, event_log_file, and blocker_report, then resume only after the blocked route evidence is present.",
          "evidenceReferences": [
            { "path": ".agents/skills/loom-skill-enhancement/SKILL.md", "startLine": 113, "endLine": 113, "quote": "If `run` returns a runtime-owned block, pass that boundary check and continue with `dotnet so.dll resume`" },
            { "path": ".agents/skills/loom-skill-enhancement/contract.json", "startLine": 31, "endLine": 31, "quote": "\"boundary_check_fail_closed\": \"If the boundary check fails closed" }
          ]
        }
      },
      "gate.official_done": {
        "description": "Terminal gate for official runnable route to final Done.",
        "requiredOutputFamilies": [
          "checked_in_skill_markdown_asset",
          "checked_in_workflow_designer_asset",
          "workflow_runtime_copy_json",
          "event_log_file",
          "completion_manifest_reference"
        ],
        "requiredMachineReadableOutputFamilies": [
          "checked_in_skill_markdown_asset",
          "checked_in_workflow_designer_asset",
          "workflow_runtime_copy_json",
          "event_log_file",
          "completion_manifest_reference"
        ],
        "requiredHumanReviewableOutputFamilies": [
          "completion_manifest_reference"
        ],
        "passExpression": "context.Get<object?>(\u0022completion_manifest_reference\u0022) != null \u0026\u0026 context.Get<object?>(\u0022workflow_runtime_copy_json\u0022) != null \u0026\u0026 context.Get<object?>(\u0022event_log_file\u0022) != null",
        "failureGuidance": {
          "summary": "The official terminal route lacks final runtime evidence or a completion manifest tied to checked-in deliverable changes.",
          "nextAction": "Do not claim Done; continue the same run/resume chain, modify the requested checked-in assets, and regenerate completion_manifest_reference with explicit evidence mappings.",
          "evidenceReferences": [
            { "path": ".agents/skills/loom-skill-enhancement/SKILL.md", "startLine": 112, "endLine": 113, "quote": "Every later `dotnet so.dll resume` must reference the same persisted instance and state" },
            { "path": ".agents/skills/loom-skill-enhancement/contract.json", "startLine": 125, "endLine": 125, "quote": "\"completion_manifest_md\": \"Runtime-owned completion-manifest file path" }
          ]
        }
      },
      "gate.replan_history_ready": {
        "description": "Blocked-route history gate proving the planner received the current state, blocker, attempts, outcomes, and evidence before redesign.",
        "requiredOutputFamilies": [
          "replan_history",
          "blocker_report",
          "attempt_history",
          "event_log_file",
          "audit_artifacts"
        ],
        "requiredMachineReadableOutputFamilies": [
          "replan_history",
          "blocker_report",
          "attempt_history",
          "event_log_file",
          "audit_artifacts"
        ],
        "requiredHumanReviewableOutputFamilies": [
          "replan_history"
        ],
        "passExpression": "context.Get<object?>(\u0022replan_history\u0022) != null \u0026\u0026 context.Get<object?>(\u0022blocker_report\u0022) != null \u0026\u0026 context.Get<object?>(\u0022attempt_history\u0022) != null",
        "failureGuidance": {
          "summary": "The replan history gate lacks the current blocker, prior attempts, outcomes, or audit evidence required for a grounded redesign.",
          "nextAction": "Read the cited governance contract, record the current blocker and every attempted path in replan_history and attempt_history, attach blocker_report and audit_artifacts, then retry.",
          "evidenceReferences": [
            { "path": ".agents/skills/loom-skill-enhancement/assets/agents/loom-skill-enhancement-workflow-designer.agent.md", "startLine": 70, "endLine": 70, "quote": "A failed gate must leave the next agent with enough information to act without rediscovering the governing rule." },
            { "path": ".agents/skills/loom-skill-enhancement/SKILL.md", "startLine": 118, "endLine": 118, "quote": "Enter plan mode before editing target-skill deliverables." }
          ]
        }
      },
      "gate.replan_path_ready": {
        "description": "Replan gate proving the selected anchor and strategy produce a viable path to the terminal business outcome.",
        "requiredOutputFamilies": [
          "replan_strategy",
          "replan_anchor",
          "candidate_terminal_path",
          "replan_evidence_references"
        ],
        "requiredMachineReadableOutputFamilies": [
          "replan_strategy",
          "replan_anchor",
          "candidate_terminal_path",
          "replan_evidence_references"
        ],
        "requiredHumanReviewableOutputFamilies": [
          "candidate_terminal_path"
        ],
        "passExpression": "context.Get<object?>(\u0022candidate_terminal_path\u0022) != null \u0026\u0026 context.Get<object?>(\u0022replan_evidence_references\u0022) != null",
        "failureGuidance": {
          "summary": "The selected replan anchor and strategy do not yet prove a viable path to the terminal business outcome or lack traceable evidence references.",
          "nextAction": "Re-evaluate the anchor and strategy, produce candidate_terminal_path, and attach verified replan_evidence_references with relative paths, line ranges, and exact quotes before retrying.",
          "evidenceReferences": [
            { "path": ".agents/skills/loom-skill-enhancement/assets/agents/loom-skill-enhancement-workflow-designer.agent.md", "startLine": 66, "endLine": 71, "quote": "Every `validation.gates` entry is incomplete unless it contains a `failureGuidance` object" },
            { "path": ".agents/skills/loom-skill-enhancement/contract.json", "startLine": 3, "endLine": 4, "quote": "\"inputs\": {" }
          ]
        }
      }
    },
