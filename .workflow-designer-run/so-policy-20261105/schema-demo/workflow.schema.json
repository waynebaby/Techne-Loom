    "workflowStatus": [
      "drafting",
      "readyToStart",
      "running",
      "waitingExternal",
      "failed",
      "succeeded"
    ],
    "concurrencyStrategy": [
      "firstPass",
      "whenAnyResponse",
      "whenAnyPass",
      "whenAllPass",
      "whenExpression"
    ],
    "waitBehavior": [
      "blockUntilComplete",
      "waitForSignal"
